-- ============================================================
-- PROCEDURE 1
-- SALES REPORT BETWEEN TWO DATES
-- ============================================================

CREATE OR REPLACE PROCEDURE sales_report
(
    p_start_date IN DATE,
    p_end_date   IN DATE
)
AS

    v_total_sales     NUMBER;
    v_total_quantity  NUMBER;
    v_total_orders    NUMBER;

BEGIN

    SELECT
        SUM(amount),
        SUM(quantity),
        COUNT(*)
    INTO
        v_total_sales,
        v_total_quantity,
        v_total_orders
    FROM retail_sales
    WHERE sale_date BETWEEN p_start_date AND p_end_date;


    DBMS_OUTPUT.PUT_LINE(
        'Start Date     : ' ||
        TO_CHAR(p_start_date, 'DD-MM-YYYY')
    );

    DBMS_OUTPUT.PUT_LINE(
        'End Date       : ' ||
        TO_CHAR(p_end_date, 'DD-MM-YYYY')
    );

    DBMS_OUTPUT.PUT_LINE(
        'Total Sales    : ' || v_total_sales
    );

    DBMS_OUTPUT.PUT_LINE(
        'Total Quantity : ' || v_total_quantity
    );

    DBMS_OUTPUT.PUT_LINE(
        'Total Orders   : ' || v_total_orders
    );

END;
/


-- ============================================================
-- CALL PROCEDURE 1
-- ============================================================

BEGIN

    sales_report(
        TO_DATE('01-10-2026','DD-MM-YYYY'),
        TO_DATE('10-10-2026','DD-MM-YYYY')
    );

END;
/


